{
  "name": "aprendendo-palavras",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "description": "PWA para estudar idiomas com flashcards, leitura em voz alta e PDFs revisáveis.",
  "homepage": "https://joshpcbrrj.github.io/projeto-palavras/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joshpcbrrj/projeto-palavras.git"
  },
  "bugs": {
    "url": "https://github.com/Joshpcbrrj/projeto-palavras/issues"
  },
  "author": "Josué B. Almeida",
  "license": "MIT",
  "keywords": [
    "flashcard",
    "language-learning",
    "text-to-speech",
    "web-speech-api",
    "pdf",
    "pwa",
    "education"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "icons": "node scripts/generate-icons.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "jspdf": "4.2.1",
    "lint-staged": "^17.6.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
